{
  "name": "rosetta",
  "description": "Rosetta MCP integration providing project context, architecture guidance, reusable patterns, and development workflows.",
  "version": "1.0.0",

  "type": "mcp-server",

  "server": {
    "command": "npx",
    "args": [
      "-y",
      "@griddynamics/rosetta-mcp-server"
    ]
  },

  "env": {
    "ROSETTA_WORKSPACE": "${WORKSPACE_ROOT}"
  },

  "capabilities": [
    "project_context",
    "architecture_guidance",
    "code_patterns",
    "development_workflows"
  ],

  "permissions": {
    "read": true,
    "write": false
  }
}