{
  "name": "@dpurge/agent-tools",
  "version": "0.1.1",
  "description": "Portable AI agent toolkit with skills, subagents, workflows, and rules for Claude Code, OpenCode, and Pi.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "DPurge",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpurge/agent-tools.git"
  },
  "keywords": [
    "ai-agent",
    "agents",
    "skills",
    "claude-code",
    "opencode",
    "pi",
    "mcp",
    "llm",
    "developer-tools"
  ],
  "bin": {
    "agent-tools": "./scripts/cli.js"
  },
  "files": [
    "core",
    "adapters",
    "extensions",
    "scripts",
    "agent-tools.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.js",
    "validate:specs": "node scripts/validate-specs.js",
    "build": "node scripts/build.js",
    "set-version": "node scripts/set-version.js",
    "install:claude": "node scripts/install-claude.js",
    "install:opencode": "node scripts/install-opencode.js",
    "install:pi": "node scripts/install-pi.js",
    "install:editable:claude": "node scripts/install-editable-claude.js",
    "install:editable:opencode": "node scripts/install-editable-opencode.js",
    "install:editable:pi": "node scripts/install-editable-pi.js",
    "uninstall:editable:claude": "node scripts/uninstall-editable-claude.js",
    "uninstall:editable:opencode": "node scripts/uninstall-editable-opencode.js",
    "uninstall:editable:pi": "node scripts/uninstall-editable-pi.js",
    "install:dev": "npm run build && npm link",
    "test:scripts": "node --test scripts/*.test.js",
    "test:packages": "node scripts/test-packages.js",
    "test": "npm run validate && npm run validate:specs && npm run test:scripts && npm run test:packages"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "front-matter": "^4.0.2",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "prettier": "^3.5.0",
    "typebox": "^1.3.32"
  },
  "engines": {
    "node": ">=20"
  },
  "agentKit": {
    "schemaVersion": "1",
    "targets": {
      "claude": {
        "adapter": "./adapters/claude-code"
      },
      "opencode": {
        "adapter": "./adapters/opencode"
      },
      "pi": {
        "adapter": "./adapters/pi"
      }
    },
    "directories": {
      "skills": "core/skills",
      "agents": "core/agents",
      "workflows": "core/workflows",
      "rules": "core/rules"
    }
  }
}
